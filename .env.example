# EduPath AI Configuration
# Optional: Provide Gemini or Groq API key for live AI generation.
# If omitted or offline, EduPath's deterministic agent engine ensures full end-to-end functionality.

GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# LLM Model Configuration
LLM_PROVIDER=auto
LLM_MODEL=gemini-2.0-flash

# Database path (defaults to local SQLite database in backend directory)
EDUPATH_DB_PATH=backend/edupath.db
